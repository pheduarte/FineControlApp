<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.pheduarte.finecontrol.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_transactionsFragment"
            app:destination="@id/transactionsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_newFragment"
            app:destination="@id/newFragment" />
        <action
            android:id="@+id/action_homeFragment_to_budgetFragment"
            app:destination="@id/budgetFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.pheduarte.finecontrol.ui.main.BudgetFragment"
        android:label="Budget"
        tools:layout="@layout/fragment_budget" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.pheduarte.finecontrol.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_accountSettingsFragment"
            app:destination="@id/accountSettingsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_helpSupportFragment"
            app:destination="@id/helpSupportFragment" />
        <action
            android:id="@+id/action_profileFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_privacySecurityFragment"
            app:destination="@id/privacySecurityFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.pheduarte.finecontrol.ui.main.TransactionsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_transactions" />

    <fragment
        android:id="@+id/newFragment"
        android:name="com.pheduarte.finecontrol.ui.main.NewFragment"
        android:label="New"
        tools:layout="@layout/fragment_new" >
        <action
            android:id="@+id/action_newFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/accountSettingsFragment"
        android:name="com.pheduarte.finecontrol.profile.AccountSettingsFragment"
        android:label="fragment_account_settings"
        tools:layout="@layout/fragment_account_settings" />
    <fragment
        android:id="@+id/helpSupportFragment"
        android:name="com.pheduarte.finecontrol.profile.HelpSupportFragment"
        android:label="fragment_help_support"
        tools:layout="@layout/fragment_help_support" >
        <action
            android:id="@+id/action_helpSupportFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.pheduarte.finecontrol.profile.NotificationsFragment"
        android:label="fragment_notifications"
        tools:layout="@layout/fragment_notifications" >
        <action
            android:id="@+id/action_notificationsFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/privacySecurityFragment"
        android:name="com.pheduarte.finecontrol.profile.PrivacySecurityFragment"
        android:label="fragment_privacy_security"
        tools:layout="@layout/fragment_privacy_security" >
        <action
            android:id="@+id/action_privacySecurityFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>


</navigation>
